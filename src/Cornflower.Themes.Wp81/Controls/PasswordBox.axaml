<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cf="using:Cornflower.Controls"
                    xmlns:wp81="using:Cornflower.Themes.Wp81">
  <!--
    The Windows Phone 8.1 PasswordBox: the default style of the 8.1 Update 1 runtime (passwordbox.json, which equals
    the SDK's generic.xaml), re-expressed as an Avalonia ControlTheme for TextBox under WinRT's name, PasswordBox, as
    the TextBlock styles are keyed by theirs. Avalonia has no PasswordBox type: its TextBox masks its text with
    PasswordChar. An app asks for the phone's with the key:

      <TextBox Theme="{DynamicResource PasswordBox}" />
      <TextBox Theme="{DynamicResource PasswordBox}" Classes="revealPasswordButton" />

    The second is WinRT's IsPasswordRevealButtonEnabled: Avalonia's own class for a reveal button (Simple's and
    Fluent's), here the phone's "Show Password" CheckBox. docs/controls/PasswordBox/PLAN.md has the values, their
    sources and why it is a key.

    The phone's PasswordBox style is its own, not based on the TextBox's, and so is this: the same setters but
    TextWrapping, the same template but the ContentElement's margin (RichEditBoxTextThemeMargin, 2.5, the border's
    thickness by another key), the placeholder's size (the box's, not ContentControlFontSize) and a third row, the
    RevealButton. The pieces that are the same are the TextBox theme's own (Controls/TextBox.axaml): its ScrollViewer
    part's theme, Wp81TextBoxScrollViewerTheme, by DynamicResource, as a StaticResource can't reach into another file;
    PhoneTextBoxLine for the phone's line; PhoneHeaderLine for the header's and the placeholder's.
    - RevealButton is a CheckBox, in Wp81's CheckBox theme (#31), its IsChecked Avalonia's RevealPassword both ways,
      its text "Show Password" (Wp81PasswordBoxRevealText), shown while the box has the revealPasswordButton class.
      PasswordBoxCheckBoxThemeMargin lifts it 6.5 into the row above.

    The visual states: the TextBox's three, and PointerOver, which sets nothing but ends Normal's 0.8, so the box is
    drawn whole under a pointer. ButtonStates: ButtonVisible and ButtonCollapsed, by the class.
  -->

  <!-- The RevealButton's text, which WinRT's code sets from its resources. -->
  <x:String x:Key="Wp81PasswordBoxRevealText">Show Password</x:String>

  <ControlTheme x:Key="PasswordBox" TargetType="TextBox">
    <Setter Property="MinWidth" Value="{DynamicResource TextControlThemeMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    <!-- WinRT's SelectionHighlightColor. -->
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionHighlightColorThemeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundThemeBrush}" />
    <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundThemeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderThemeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
    <Setter Property="FontFamily" Value="{DynamicResource PhoneFontFamilyNormal}" />
    <Setter Property="FontSize" Value="{DynamicResource ContentControlFontSize}" />
    <!-- WinRT's PasswordChar, by default a black circle; a PasswordBox is one line, and takes no return. -->
    <Setter Property="PasswordChar" Value="●" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <!-- The phone's line, 1.33 em of the FontSize (PhoneTextBoxLine), as the TextBox's. -->
    <Setter Property="LineHeight" Value="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={x:Static wp81:PhoneTextBoxLine.Converter}}" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
    <Setter Property="Margin" Value="{DynamicResource TextControlMarginThemeThickness}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextBoxPlaceholderTextThemeBrush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent" RowDefinitions="Auto,*,Auto">
          <Border x:Name="BorderElement"
                  Grid.Row="1"
                  BackgroundSizing="InnerBorderEdge"
                  Opacity="{DynamicResource TextControlBorderThemeOpacity}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" />
          <ContentPresenter x:Name="HeaderContentPresenter"
                            Grid.Row="0"
                            Margin="{DynamicResource TextControlHeaderMarginThemeThickness}"
                            IsVisible="{TemplateBinding (cf:ControlHeader.Header), Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{TemplateBinding (cf:ControlHeader.Header)}"
                            ContentTemplate="{TemplateBinding (cf:ControlHeader.HeaderTemplate)}"
                            FontFamily="{DynamicResource PhoneFontFamilyNormal}"
                            FontSize="{DynamicResource TextStyleMediumFontSize}"
                            FontWeight="Normal"
                            Foreground="{DynamicResource PhoneMidBrush}"
                            wp81:PhoneHeaderLine.IsEnabled="True" />
          <!-- ContentElement's MinHeight is here: Avalonia's TextBox sets its ScrollViewer's in every measure. At the top of
               its row: with the RevealButton shown the row is shorter than the text's 34 (the Grid gives it 31.25, the
               phone's too), and the phone's ScrollViewer keeps its top and overflows below, where Avalonia would centre. -->
          <Grid x:Name="ContentRow"
                Grid.Row="1"
                VerticalAlignment="Top"
                Margin="{DynamicResource RichEditBoxTextThemeMargin}"
                MinHeight="{DynamicResource TextControlThemeMinHeight}"
                ColumnDefinitions="Auto,*,Auto">
            <ContentPresenter x:Name="InnerLeftContentPresenter" Content="{TemplateBinding InnerLeftContent}" />
            <ScrollViewer x:Name="PART_ScrollViewer"
                          Grid.Column="1"
                          Theme="{DynamicResource Wp81TextBoxScrollViewerTheme}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                          IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                          IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                          BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                          AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}">
              <!-- As the TextBox's: CaretIndex the box sets itself; LineHeight, LetterSpacing, TextAlignment and
                   TextWrapping inherit. -->
              <TextPresenter x:Name="PART_TextPresenter"
                             CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                             CaretBrush="{TemplateBinding CaretBrush}"
                             PasswordChar="{TemplateBinding PasswordChar}"
                             RevealPassword="{TemplateBinding RevealPassword}"
                             SelectionBrush="{TemplateBinding SelectionBrush}"
                             SelectionEnd="{TemplateBinding SelectionEnd}"
                             SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                             SelectionStart="{TemplateBinding SelectionStart}"
                             Text="{TemplateBinding Text, Mode=TwoWay}" />
            </ScrollViewer>
            <!-- The phone's sets no FontSize here, unlike the TextBox's: the placeholder is the box's size. -->
            <ContentPresenter x:Name="PlaceholderTextContentPresenter"
                              Grid.Column="1"
                              IsHitTestVisible="False"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Top"
                              Content="{TemplateBinding PlaceholderText}"
                              Foreground="{TemplateBinding PlaceholderForeground}"
                              wp81:PhoneHeaderLine.IsEnabled="True" />
            <ContentPresenter x:Name="InnerRightContentPresenter" Grid.Column="2" Content="{TemplateBinding InnerRightContent}" />
          </Grid>
          <CheckBox x:Name="RevealButton"
                    Grid.Row="2"
                    IsVisible="False"
                    IsTabStop="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="{DynamicResource PasswordBoxCheckBoxThemeMargin}"
                    Content="{DynamicResource Wp81PasswordBoxRevealText}"
                    IsChecked="{TemplateBinding RevealPassword, Mode=TwoWay}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- The box's own text values inherit, and are its text's: each other part takes Avalonia's defaults back, so the
         header, the placeholder, the inner content and the RevealButton's text keep their own. (The CheckBox's text
         takes the phone's line from PhoneContentLine whatever it inherits.) -->
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="LineHeight" Value="NaN" />
      <Setter Property="TextAlignment" Value="Start" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="^ /template/ CheckBox#RevealButton">
      <!-- The template's Foreground, set here as the CheckBox theme's own setter would win over the template's. -->
      <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundHeaderThemeBrush}" />
      <Setter Property="TextBlock.TextAlignment" Value="Start" />
      <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
      <Setter Property="TextBlock.LetterSpacing" Value="0" />
    </Style>

    <!-- ButtonStates: the RevealButton while the box asks for it, WinRT's IsPasswordRevealButtonEnabled. -->
    <Style Selector="^.revealPasswordButton /template/ CheckBox#RevealButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The placeholder only while the box is empty. -->
    <Style Selector="^:not(:empty) /template/ ContentPresenter#PlaceholderTextContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- PointerOver: an empty state, so Normal's 0.8 ends. -->
    <Style Selector="^:pointerover /template/ Border#BorderElement">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Focused. -->
    <Style Selector="^:focus /template/ Border#BorderElement">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextSelectionHighlightColorThemeBrush}" />
      <Setter Property="Background" Value="{DynamicResource TextBoxFocusedBackgroundThemeBrush}" />
    </Style>
    <Style Selector="^:focus /template/ ContentPresenter#PlaceholderTextContentPresenter">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Disabled. -->
    <Style Selector="^:disabled /template/ Border#BorderElement">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource TextBoxDisabledBackgroundThemeBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextBoxDisabledBorderThemeBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="Foreground" Value="{DynamicResource TextBoxDisabledForegroundThemeBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PlaceholderTextContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextBoxDisabledForegroundThemeBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#HeaderContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextBoxDisabledHeaderForegroundThemeBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cornflower.Themes.Wp81</PackageId>
    <Description>The Windows Phone 8.1 theme: ControlThemes for Avalonia's controls and Cornflower's, and the era's tokens.</Description>
    <IsPackable>true</IsPackable>
    <!-- The bundled Selawik fonts are OFL-1.1 (ADR 0003). -->
    <PackageLicenseExpression>Apache-2.0 AND OFL-1.1</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- *.axaml files are included automatically by Avalonia 12's build props. -->

  <!-- Selawik 1.01 (SIL OFL 1.1). Semilight is in a folder of its own: see Fonts/README.md.
       The licence travels with the fonts in the package. -->
  <ItemGroup>
    <AvaloniaResource Include="Fonts/**/*.ttf" />
    <None Include="Fonts/OFL.txt" Pack="true" PackagePath="fonts/Selawik/OFL.txt" />
  </ItemGroup>

  <!-- Merged by Wp81Theme; see Directory.Build.targets. -->
  <PropertyGroup>
    <CornflowerDiscoverXaml>true</CornflowerDiscoverXaml>
  </PropertyGroup>
  <ItemGroup>
    <CornflowerDiscoveredXaml Include="Tokens/**/*.axaml;Controls/**/*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cornflower.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cornflower.Controls\Cornflower.Controls.csproj" />
  </ItemGroup>

</Project>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Windows Phone 8.1 theme colours and brushes, dark and light.

    Source: themeresources.xaml of the Windows Phone 8.1 SDK (Windows Phone Kits\8.1\Include\abi\Xaml\Design),
    read as a specification. Its Default dictionary is the dark theme and is ThemeVariant Dark here; its Light
    dictionary is Light. HighContrastBlack and HighContrastWhite are not here yet. The keys are the SDK's own.

    Each entry ends with a comment naming its source key and, where the reference app read the value on the
    phone, "run:" with the capture's specimen, variant and state (refapp run 20261108-1443-dev11, device 11, the
    reference profile; index.json is the run's own resource read). A run value is the file's unless the comment
    says otherwise.

    A brush gives the colour key it takes in its Color. The accent comes from SystemColorControlAccentColor, in
    Accent.axaml, through a DynamicResource, so an app that redefines that colour moves every accent brush.
    Every other brush takes its colour from its own theme dictionary through a StaticResource, fixed when the
    file loads.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Colours (27) -->
      <Color x:Key="ContentDialogDimmingColor">#99000000</Color> <!-- ContentDialogDimmingColor -->
      <Color x:Key="PhoneBackgroundColor">#FF000000</Color> <!-- PhoneBackgroundColor -->
      <Color x:Key="PhoneBaseBlackColor">#FF000000</Color> <!-- PhoneBaseBlackColor -->
      <Color x:Key="PhoneBaseHighColor">#FFFFFFFF</Color> <!-- PhoneBaseHighColor -->
      <Color x:Key="PhoneBaseLowColor">#73FFFFFF</Color> <!-- PhoneBaseLowColor -->
      <Color x:Key="PhoneBaseLowSolidColor">#FF747474</Color> <!-- PhoneBaseLowSolidColor -->
      <Color x:Key="PhoneBaseMediumHighColor">#CCFFFFFF</Color> <!-- PhoneBaseMediumHighColor -->
      <Color x:Key="PhoneBaseMediumMidColor">#80FFFFFF</Color> <!-- PhoneBaseMediumMidColor -->
      <Color x:Key="PhoneBaseMediumMidSolidColor">#FF666666</Color> <!-- PhoneBaseMediumMidSolidColor -->
      <Color x:Key="PhoneBaseMidColor">#99FFFFFF</Color> <!-- PhoneBaseMidColor -->
      <Color x:Key="PhoneBaseWhiteColor">#FFFFFFFF</Color> <!-- PhoneBaseWhiteColor -->
      <Color x:Key="PhoneChromeColor">#FF1F1F1F</Color> <!-- PhoneChromeColor -->
      <Color x:Key="PhoneControlBackgroundColor">Transparent</Color> <!-- PhoneControlBackgroundColor -->
      <Color x:Key="PhoneControlDisabledColor">#66FFFFFF</Color> <!-- PhoneControlDisabledColor -->
      <Color x:Key="PhoneControlForegroundColor">#FFFFFFFF</Color> <!-- PhoneControlForegroundColor -->
      <Color x:Key="PhoneDisabledColor">#66FFFFFF</Color> <!-- PhoneDisabledColor -->
      <Color x:Key="PhoneForegroundColor">#FFFFFFFF</Color> <!-- PhoneForegroundColor -->
      <Color x:Key="PhoneImagePlaceholderColor">#FF3D3D3D</Color> <!-- PhoneImagePlaceholderColor -->
      <Color x:Key="PhonePageBackgroundColor">#FF000000</Color> <!-- PhonePageBackgroundColor -->
      <Color x:Key="PhoneTextHighColor">#FFFFFFFF</Color> <!-- PhoneTextHighColor -->
      <Color x:Key="PhoneTextLowColor">#73FFFFFF</Color> <!-- PhoneTextLowColor -->
      <Color x:Key="PhoneTextMidColor">#99FFFFFF</Color> <!-- PhoneTextMidColor -->
      <Color x:Key="PhoneTextOverAccentColor">#FFFFFFFF</Color> <!-- PhoneTextOverAccentColor -->
      <Color x:Key="TextBoxBackgroundColor">#FFFFFFFF</Color> <!-- TextBoxBackgroundColor -->
      <Color x:Key="TextBoxBorderColor">#FFFFFFFF</Color> <!-- TextBoxBorderColor -->
      <Color x:Key="TextBoxForegroundColor">#FF000000</Color> <!-- TextBoxForegroundColor -->
      <Color x:Key="TextBoxPlaceholderColor">#FF909090</Color> <!-- TextBoxPlaceholderColor -->
      <!-- Brushes (291) -->
      <SolidColorBrush x:Key="AppBarBackgroundThemeBrush" Color="{StaticResource PhonePageBackgroundColor}" /> <!-- AppBarBackgroundThemeBrush -->
      <SolidColorBrush x:Key="AppBarBorderThemeBrush" Color="{StaticResource PhonePageBackgroundColor}" /> <!-- AppBarBorderThemeBrush -->
      <SolidColorBrush x:Key="AppBarItemDisabledForegroundThemeBrush" Color="{StaticResource PhoneDisabledColor}" /> <!-- AppBarItemDisabledForegroundThemeBrush; run: AppBarButton default CommonStates.Disabled -->

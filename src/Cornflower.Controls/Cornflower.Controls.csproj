<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cornflower.Controls</PackageId>
    <Description>Cornflower's own controls, subclasses, part classes and attached behaviours: behaviour only, no visual opinion. Pair with a Cornflower theme or your own templates.</Description>
    <IsPackable>true</IsPackable>
    <!-- The Lucide icons are ISC, and those Lucide took from Feather are MIT: Icons/LICENSE. -->
    <PackageLicenseExpression>Apache-2.0 AND ISC AND MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- Lucide's icons, generated by tools/lucide: Icons/LucideIconKind.g.cs, Icons/lucide.br and its
       licence, which travels with them in the package. -->
  <ItemGroup>
    <EmbeddedResource Include="Icons/lucide.br" LogicalName="Cornflower.Controls.Icons.lucide.br" />
    <None Include="Icons/LICENSE" Pack="true" PackagePath="icons/Lucide/LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cornflower.Tests" />
    <!-- The theme's timelines run on CornflowerClock, as Tilt does. -->
    <InternalsVisibleTo Include="Cornflower.Themes.Wp81" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android head: the sample on a real phone (ADR 0002, "Platforms"). Not in Cornflower.sln,
       because it needs the android workload; CI builds it in a job of its own, and
       tools/android/run.ps1 installs and runs it on the device. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <ApplicationId>io.github.wdcossey.cornflower.sample</ApplicationId>
    <ApplicationTitle>Cornflower</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Debug builds too: run.ps1 installs the -Signed.apk with adb, which Fast Deployment's
         assembly-less Debug APK can't start from. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cornflower.Sample\Cornflower.Sample.csproj" />
  </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cornflower.Sample.Pages.ButtonPage"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
             Foreground="{DynamicResource PhoneForegroundBrush}"
             FontFamily="{DynamicResource PhoneFontFamilyNormal}"
             FontSize="{DynamicResource TextStyleLargeFontSize}">
  <!--
    The 8.1 Button, as an 8.1 page writes one: no style, no size. Press one to see the accent and the tilt; the
    disabled ones are dimmed; the light section is the same Buttons in the light theme. The section headings
    are the type ramp's, by their keys.
  -->
  <ScrollViewer>
    <StackPanel Margin="19,12,19,24">
      <TextBlock Text="CORNFLOWER" FontFamily="{DynamicResource PhoneFontFamilySemiBold}"
                 FontSize="{DynamicResource TextStyleMediumFontSize}" />
      <TextBlock x:Name="PageTitle" Margin="-2,0,0,12"
                 FontFamily="{DynamicResource PhoneFontFamilySemiLight}"
                 FontSize="{DynamicResource PivotHeaderItemFontSize}" />

      <TextBlock Text="default" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
      <Button x:Name="Default" Content="button" Click="OnClick" />
      <TextBlock x:Name="Clicks" Text="not clicked yet" Theme="{DynamicResource ControlContextualInfoTextBlockStyle}" />

      <TextBlock Text="disabled" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <Button x:Name="Disabled" Content="button" IsEnabled="False" />

      <TextBlock Text="longer content" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <Button x:Name="Longer" Content="a button with longer content" />

      <TextBlock Text="stretched" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <Button x:Name="Stretched" Content="stretched" HorizontalAlignment="Stretch" />

      <TextBlock Text="side by side" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <Grid ColumnDefinitions="*,*">
        <Button Content="ok" HorizontalAlignment="Stretch" Margin="0,0,9.5,0" />
        <Button Grid.Column="1" Content="cancel" HorizontalAlignment="Stretch" Margin="9.5,0,0,0" />
      </Grid>

      <ThemeVariantScope RequestedThemeVariant="Light" Margin="-19,12,-19,0">
        <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}" Padding="19,6,19,12">
          <StackPanel>
            <TextBlock Text="light" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
            <Button x:Name="Light" Content="button" />
            <Button x:Name="LightDisabled" Content="button" IsEnabled="False" />
          </StackPanel>
        </Border>
      </ThemeVariantScope>
    </StackPanel>
  </ScrollViewer>
</UserControl>

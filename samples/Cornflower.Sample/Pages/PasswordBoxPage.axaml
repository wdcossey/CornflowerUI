<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cf="using:Cornflower.Controls"
             xmlns:sample="using:Cornflower.Sample"
             x:Class="Cornflower.Sample.Pages.PasswordBoxPage"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
             Foreground="{DynamicResource PhoneForegroundBrush}"
             FontFamily="{DynamicResource PhoneFontFamilyNormal}"
             FontSize="{DynamicResource TextStyleLargeFontSize}">
  <!--
    The 8.1 PasswordBox, as an Avalonia app asks for it: a TextBox with the PasswordBox key (WinRT's control), the
    revealPasswordButton class for WinRT's IsPasswordRevealButtonEnabled, the header by cf:ControlHeader.Header. Type
    in the first: it shows circles, and its length below; tick "Show Password" to read it. The section headings are
    the type ramp's.
  -->
  <ScrollViewer>
    <StackPanel Margin="19,12,19,24">
      <sample:SamplePageHeader x:Name="Header" />

      <TextBlock Text="with show password" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
      <TextBox x:Name="Secret" Theme="{DynamicResource PasswordBox}" Classes="revealPasswordButton"
               cf:ControlHeader.Header="password" PlaceholderText="type a password" TextChanged="OnTextChanged" />
      <TextBlock x:Name="State" Theme="{DynamicResource ControlContextualInfoTextBlockStyle}" />

      <TextBlock Text="plain, no header" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <TextBox x:Name="Plain" Theme="{DynamicResource PasswordBox}" Text="secret" />

      <TextBlock Text="disabled" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <TextBox x:Name="Disabled" Theme="{DynamicResource PasswordBox}" Classes="revealPasswordButton"
               cf:ControlHeader.Header="pin" Text="1234" IsEnabled="False" />

      <ThemeVariantScope RequestedThemeVariant="Light" Margin="-19,12,-19,0">
        <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}" Padding="19,6,19,12">
          <StackPanel>
            <TextBlock Text="light" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
            <TextBox x:Name="Light" Theme="{DynamicResource PasswordBox}" Classes="revealPasswordButton"
                     cf:ControlHeader.Header="password box" Text="secret" />
          </StackPanel>
        </Border>
      </ThemeVariantScope>
    </StackPanel>
  </ScrollViewer>
</UserControl>

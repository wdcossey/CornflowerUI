<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cornflower.Sample.MainView"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
             Foreground="{DynamicResource PhoneForegroundBrush}"
             FontFamily="{DynamicResource PhoneFontFamilyNormal}"
             FontSize="{DynamicResource TextStyleLargeFontSize}">
  <!--
    What the theme has today: its tokens and fonts, read through their WinRT keys, and the text
    styles. No other control is themed yet, so this page uses only panels, borders and text. Pages per
    control come with them.
    The view's padding follows the device's safe area (TopLevel.AutoSafeAreaPadding, on by default).
    In a Debug build, a line along the bottom says what the page cost to open (docs/performance/README.md).
  -->
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontFamily" Value="{DynamicResource PhoneFontFamilySemiLight}" />
      <Setter Property="FontSize" Value="{DynamicResource TextStyleExtraLargePlusFontSize}" />
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
  <TextBlock x:Name="PerformanceLine" DockPanel.Dock="Bottom" IsVisible="False" Margin="19,6"
             TextWrapping="Wrap" Foreground="{DynamicResource PhoneMidBrush}"
             FontSize="{DynamicResource TextStyleSmallFontSize}" />
  <ScrollViewer>
    <StackPanel Margin="19,12,19,24" Spacing="6">
      <TextBlock Text="CORNFLOWER" FontFamily="{DynamicResource PhoneFontFamilySemiBold}"
                 FontSize="{DynamicResource TextStyleMediumFontSize}" />
      <TextBlock x:Name="PageTitle" Margin="-2,0,0,12"
                 FontFamily="{DynamicResource PhoneFontFamilySemiLight}"
                 FontSize="{DynamicResource PivotHeaderItemFontSize}" />

      <TextBlock Text="accent" Classes="section" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border x:Name="AccentSwatch" Width="96" Height="96" Background="{DynamicResource PhoneAccentBrush}" />
        <TextBlock Text="SystemColorControlAccentColor" VerticalAlignment="Bottom"
                   FontSize="{DynamicResource TextStyleMediumFontSize}" />
      </StackPanel>

      <TextBlock Text="named accents" Classes="section" />
      <WrapPanel x:Name="NamedAccents" />

      <TextBlock Text="type ramp" Classes="section" />
      <StackPanel x:Name="TypeRamp" />

      <!-- The 8.1 text styles, each by its key, as an 8.1 page would set Style. DynamicResource, so the page
           also loads where the theme isn't the application's (the tests); in an app whose Application.Styles
           has Wp81Theme, StaticResource works as on the phone. -->
      <TextBlock Text="text styles" Classes="section" />
      <StackPanel x:Name="TextStyles" Spacing="6">
        <TextBlock x:Name="HeaderTextBlockStyle" Theme="{DynamicResource HeaderTextBlockStyle}" Text="header" />
        <TextBlock x:Name="SubheaderTextBlockStyle" Theme="{DynamicResource SubheaderTextBlockStyle}" Text="subheader" />
        <TextBlock x:Name="ListViewItemTextBlockStyle" Theme="{DynamicResource ListViewItemTextBlockStyle}" Text="list view item" />
        <TextBlock x:Name="ListViewItemSubheaderTextBlockStyle" Theme="{DynamicResource ListViewItemSubheaderTextBlockStyle}" Text="list view item subheader" />
        <TextBlock x:Name="ListViewItemContentTextBlockStyle" Theme="{DynamicResource ListViewItemContentTextBlockStyle}" Text="list view item content" />
        <TextBlock x:Name="ListViewEmptyStaticTextBlockStyle" Theme="{DynamicResource ListViewEmptyStaticTextBlockStyle}" Text="list view empty" />
        <TextBlock x:Name="GroupHeaderTextBlockStyle" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Text="group header" />
        <TextBlock x:Name="MessageDialogTitleStyle" Theme="{DynamicResource MessageDialogTitleStyle}" Text="message dialog title" />
        <TextBlock x:Name="MessageDialogContentStyle" Theme="{DynamicResource MessageDialogContentStyle}" Text="message dialog content" />
        <TextBlock x:Name="TitleTextBlockStyle" Theme="{DynamicResource TitleTextBlockStyle}" Text="title" />
        <TextBlock x:Name="FlyoutPickerTitleTextBlockStyle" Theme="{DynamicResource FlyoutPickerTitleTextBlockStyle}" Text="FLYOUT PICKER TITLE" />
        <TextBlock x:Name="BaseTextBlockStyle" Theme="{DynamicResource BaseTextBlockStyle}" Text="base" />
        <TextBlock x:Name="BodyTextBlockStyle" Theme="{DynamicResource BodyTextBlockStyle}"
                   Text="body: lines of a paragraph sit 24 apart, baseline to baseline, and wrap between words" />
        <TextBlock x:Name="ControlHeaderTextBlockStyle" Theme="{DynamicResource ControlHeaderTextBlockStyle}" Text="control header" />
        <TextBlock x:Name="ControlContextualInfoTextBlockStyle" Theme="{DynamicResource ControlContextualInfoTextBlockStyle}" Text="control contextual info" />
        <TextBlock x:Name="ComboBoxPlaceholderTextBlockStyle" Theme="{DynamicResource ComboBoxPlaceholderTextBlockStyle}" Text="combo box placeholder" />
      </StackPanel>

      <TextBlock Text="font families" Classes="section" />
      <StackPanel x:Name="FontFamilies" />

      <TextBlock Text="device" Classes="section" />
      <TextBlock x:Name="DeviceFactsText" TextWrapping="Wrap"
                 Foreground="{DynamicResource PhoneMidBrush}"
                 FontSize="{DynamicResource TextStyleMediumFontSize}" />
    </StackPanel>
  </ScrollViewer>
  </DockPanel>
</UserControl>

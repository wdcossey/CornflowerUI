<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cornflower.Sample.SampleShell"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
             Foreground="{DynamicResource PhoneForegroundBrush}"
             FontFamily="{DynamicResource PhoneFontFamilyNormal}"
             FontSize="{DynamicResource TextStyleLargeFontSize}">
  <!--
    The catalogue: a list of the pages marked [SamplePage], one per control, and Back. MainWindow
    holds it on desktop, and App shows it on a phone, without the rail. The list's buttons are the phone's
    Button, stretched across the list. Back is the sample's chrome, not the phone's, so it has a theme of its
    own, RailButton. Back is also Avalonia's own back request (Alt+Left on desktop, the back button or
    gesture on a phone).
  -->
  <UserControl.Resources>
    <!-- Back's theme: an icon on the rail, with none of the phone Button's minimum size, overhang, accent or tilt.
         The pointer over it shows PhoneLowBrush behind it, the phone's pointer-over brush for its own chrome
         (ButtonPointerOverBackgroundThemeBrush's colour); a press dims it. -->
    <ControlTheme x:Key="RailButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </ControlTemplate>
      </Setter>
      <!-- No focus rectangle: the theme under Wp81 would draw its own, and the phone draws none. -->
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PhoneLowBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.6" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <!--
    Back sits in a rail of its own to the right of the page, as the phone's navigation bar does in landscape,
    so that a page has the whole view, 450 x 800 in the reference profile, with nothing drawn over it.
    The rail is the sample's chrome, not the phone's: MainWindow is 40 wider for it, a whole number of pixels at every common scaling (1.25, 1.5, 1.75, 2, 2.4), so the page keeps exactly 450.
  -->
  <Grid ColumnDefinitions="*,Auto">
    <ContentControl x:Name="Host">
      <ScrollViewer x:Name="Index">
        <StackPanel Margin="19,12,19,24" Spacing="6">
          <TextBlock Text="CORNFLOWER" FontFamily="{DynamicResource PhoneFontFamilySemiBold}"
                     FontSize="{DynamicResource TextStyleMediumFontSize}" />
          <TextBlock Text="samples" Margin="-2,0,0,12"
                     FontFamily="{DynamicResource PhoneFontFamilySemiLight}"
                     FontSize="{DynamicResource PivotHeaderItemFontSize}" />
          <StackPanel x:Name="PageList" Spacing="9.6" />
        </StackPanel>
      </ScrollViewer>
    </ContentControl>

    <!-- On a phone (HasBackRail off) the rail is collapsed: the platform's back request is Back there. -->
    <Border x:Name="Rail" Grid.Column="1" Width="40" Background="#FF000000">
      <DockPanel>
        <Button x:Name="BackButton" Theme="{StaticResource RailButton}" DockPanel.Dock="Bottom" IsVisible="False" Click="OnBack"
                AutomationProperties.Name="Back" Width="40" Height="40"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
          <Path Data="M 15,4 L 7,12 L 15,20 M 7,12 L 21,12" Stroke="#FFFFFFFF" StrokeThickness="2"
                StrokeLineCap="Round" StrokeJoin="Round" Width="24" Height="24" />
        </Button>
        <!--
          What the page cost to open, in a Debug build, read up the rail above Back: in the sample's chrome, so that
          nothing is drawn over the page, which keeps its whole view in every build, its content and its frames
          (docs/performance/README.md). The shell also writes it to standard output, which is where a phone, with
          no rail, has it.
        -->
        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
          <LayoutTransformControl.LayoutTransform>
            <RotateTransform Angle="-90" />
          </LayoutTransformControl.LayoutTransform>
          <TextBlock x:Name="PerformanceLine" IsVisible="False" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource PhoneMidBrush}"
                     FontSize="{DynamicResource TextStyleSmallFontSize}" />
        </LayoutTransformControl>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

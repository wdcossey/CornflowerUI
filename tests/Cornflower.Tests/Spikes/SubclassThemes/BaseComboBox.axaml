<!-- Spike 3: a ComboBox theme with a recognisable template, standing in for the era's own. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Tag" Value="from-base" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="BaseComboBoxRoot">
          <Popup Name="PART_Popup" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
